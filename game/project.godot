; Engine configuration file.
; Godot 4.x — open this folder as the project root.

config_version=5

[application]
config/name="Bubble Rush"
config/description="Minimalist neon arcade: trap, pop, combo."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
ComboManager="*res://scripts/combo_manager.gd"
UpgradeStore="*res://scripts/upgrade_store.gd"
Leaderboard="*res://scripts/leaderboard.gd"
ArcadeSfx="*res://scripts/arcade_sfx.gd"
TouchInput="*res://scripts/touch_input.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[layer_names]
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="bubble"
2d_physics/layer_5="pickup"

[physics]
2d/default_gravity=980

[rendering]
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)

[leaderboard]
api_base_url=""
api_key=""

[game]
force_touch_hud=false
